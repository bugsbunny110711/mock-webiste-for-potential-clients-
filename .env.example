# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.

# The coach's admin password. Required in production; without it sign-in fails
# closed and nobody can reach /admin.
ADMIN_PASSWORD=

# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# In development only, both of these fall back to insecure defaults so the
# panel can be demonstrated without any setup. Those fallbacks do not exist in
# production builds.
